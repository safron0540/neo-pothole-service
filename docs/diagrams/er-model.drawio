<mxfile host="app.diagrams.net"><diagram name="ER логическая модель" id="d0"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v242" value="Логическая модель данных: 17 сущностей" style="fontFamily=Arial;text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="-40" y="-80" width="900" height="30" as="geometry"/></mxCell><mxCell id="v243" value="Нотация «вороньи лапки» (crow’s foot), без типов СУБД. PK — ключ сущности, FK — ссылка на другую сущность, UQ — уникальное значение. Служебные поля (даты изменения, версия, источник класса) показаны только в физической модели. Цвет — группа: зелёный — справочники и геоданные, синий — пользователи и доступ, оранжевый — заявки, фиолетовый — плановый ремонт" style="fontFamily=Arial;text;html=1;fontSize=11;fontColor=#555555;align=left;whiteSpace=wrap;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="-40" y="-48" width="1640" height="34" as="geometry"/></mxCell><mxCell id="v244" value="Район" style="fontFamily=Arial;swimlane;html=1;fontStyle=1;fontSize=11;startSize=26;childLayout=none;horizontal=1;collapsible=0;fillColor=#E8F5E9;strokeColor=#5B9B5E;swimlaneFillColor=#ffffff;rounded=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="300" height="62" as="geometry"/></mxCell><mxCell id="v245" value="&lt;b&gt;PK&lt;/b&gt;" style="fontFamily=Arial;text;html=1;fontSize=10;strokeColor=none;fillColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;align=center;fontColor=#555555;" vertex="1" parent="v244"><mxGeometry x="0" y="26" width="34" height="18" as="geometry"/></mxCell><mxCell id="v246" value="&lt;u&gt;Идентификатор&lt;/u&gt;" style="fontFamily=Arial;text;html=1;fontSize=10;strokeColor=none;fillColor=none;verticalAlign=middle;overflow=hidden;rotatable=0;align=left;spacingLeft=4;" vertex="1" parent="v244"><mxGeometry x="34"