></mxCell><mxCell id="v193" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="240" y="1480" width="40" height="40" as="geometry"/></mxCell><mxCell id="e194" value="" style="fontFamily=Arial;endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v191" target="v193"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e195" value="[нет]" style="fontFamily=Arial;endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;exitX=1;exitY=0.5;entryX=1;entryY=0.5;verticalAlign=bottom;" edge="1" parent="1" source="v189" target="v193"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="1365"/><mxPoint x="580" y="1500"/></Array></mxGeometry></mxCell><mxCell id="v196" value="Сохранить заявку: статус «На проверке»,&lt;br&gt;история, уведомление автору" style="fontFamily=Arial;rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="110.0" y="1550" width="300" height="50" as="geometry"/></mxCell><mxCell id="e197" value="" style="fontFamily=Arial;endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v193" target="v196"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v198" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="245" y="1630" width="30" height="30" as="geometry"/></mxCell><mxCell id="e199" value="" style="fontFamily=Arial;endArrow=open;endSize=10;html=1;rounded=0;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;fontColor=#222222;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v196" target="v198"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v200" value="Рекомендация диспетчеру («Принять» для big, «Отклонить» для small) не хранится: она вычисляется из класса при показе заявки. Повторно шаги срока запускаются при смене класса или группы (REQ-056/057)" style="fontFamily=Arial;shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;spacingRight=6;fillColor=#FFFDE7;strokeColor=#9E9E9E;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="1540" width="290" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="UML Sequence: решение и выполнение" id="d6"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v201" value="Решение диспетчера, выполнение и уведомление (UML Sequence, UC-05/UC-06)" style="fontFamily=Arial;text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="v202" value="Любая смена статуса идёт через change_status(): блокировка строки, проверка version, история и уведомление в одной транзакции" style="fontFamily=Arial;text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1200" height="24" as="geometry"/></mxCell><mxCell id="v203" value="Диспетчер" style="fontFamily=Arial;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;outlineConnect=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="46" y="90" width="28" height="48" as="geometry"/></mxCell><mxCell id="v204" value="Подрядчик" style="fontFamily=Arial;shape=umlActor;vertica