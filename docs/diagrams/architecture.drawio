" value="SELECT … ORDER BY приоритет (REQ-045)" style="fontFamily=Arial;html=1;fontSize=11;rounded=0;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="266" as="sourcePoint"/><mxPoint x="1120" y="266" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e212" value="заявки + рекомендация системы" style="fontFamily=Arial;html=1;fontSize=11;rounded=0;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;dashed=1;endArrow=open;endSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="304" as="sourcePoint"/><mxPoint x="340" y="304" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e213" value="нажимает «Принять»" style="fontFamily=Arial;html=1;fontSize=11;rounded=0;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="342" as="sourcePoint"/><mxPoint x="340" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e214" value="POST /requests/{id}/status (Принято, version)" style="fontFamily=Arial;html=1;fontSize=11;rounded=0;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="380" as="sourcePoint"/><mxPoint x="660" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e215" value="BEGIN; SELECT … FOR UPDATE" style="fontFamily=Arial;html=1;fontSize=11;rounded=0;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#333333;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="418" as="sourcePoint"/><mxPoint x="1120" y="418" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e216" value="409 Conflict: заявку уже изменили" style="fontFamily=Arial;html=1;fontSize=11;roun