BackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.3;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="v21" target="v22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="525" y="430"/><mxPoint x="445" y="430"/></Array></mxGeometry></mxCell><mxCell id="e35" value="&lt;b&gt;Отдаёт файл по ссылке&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[X-Accel-Redirect]&lt;/span&gt;" style="fontFamily=Arial;endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1.2;endFill=1;strokeColor=#707070;endSize=10;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v22" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="&lt;b&gt;Проксирует /api&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTP]&lt;/span&gt;" style="fontFamily=Arial;endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1.2;endFill=1;strokeColor=#707070;endSize=10;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v22" target="v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="&lt;b&gt;Сохраняет файлы&lt;/b&gt;" style="fontFamily=Arial;endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1.2;endFill=1;strokeColor=#707070;endSize=10;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.8;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="v25" target="v23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="445" y="630"/><mxPoint x="712" y="630"/></Array></mxGeometry></mxCell><mxCell id="e38" value="&lt;b&gt;Собирает метрики&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[/metrics]&lt;/span&gt;" style="fontFamily=Arial;endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1.2;endFill=1;strokeColor=#707070;endSize=10;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="1" source="v24" target="v25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="645"/><mxPoint x="482" y="645"/></Array></mxGeometry></mxCell><mxCell id="e39" value="&lt;b&gt;Читает и пишет&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[SQL, SQLAlchemy]&lt;/span&gt;" style="fontFamily=Arial;endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1.2;endFill=1;strokeColor=#707070;endSize=10;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="v25" target="v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e40" value="&lt;b&gt;Проверяет фото&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTP, таймаут 8 с]&lt;/span&gt;" style="fontFamily=Arial;endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1.2;endFill=1;strokeColor=#707070;endSize=10;rounded=0;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.7;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="v25" target="v27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="845"/><mxPoint x="1070" y="845"/></Array></mxGeometry></mxCell><mxCell id="e41" value="&lt;b&gt;Push (этап 2)&lt;/b&gt;" style="fontFamily=Arial;endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1.2;endFill=1;strokeColor=#707070;endSize=10;rounded=0;labelBackgroundColor=#ffffff;dashed=1;jumpStyle=arc;jumpSize=10;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v25" target="v28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="282" y="880"/><mxPoint x="270" y="880"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="C4 L3 Компоненты API" id="d2"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v42" value="Компоненты API бэкенда (C4, уровень 3)" style="fontFamily=Arial;text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="v43" value="Из каких модулей состоит контейнер «API бэкенда»: HTTP-слой → сервисы с бизнес-правилами → доступ к данным" style="fontFamily=Arial;text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1100" height="24" as="geometry"/></mxCell><mxCell id="v44" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Прокси nginx&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Контейнер]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;HTTPS, /api → API&lt;/div&gt;" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#438DD5;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#3C7FC0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="380" y="80" width="300" height="80" as="geometry"/></mxCell><mxCell id="v45" value="API бэкенда [Контейнер: Python 3.12, FastAPI, Uvicorn]" style="fontFamily=Arial;rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=4;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=top;spacing=10;dashPattern=8 4;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="1190" height="570" as="geometry"/></mxCell><mxCell id="v46" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Роутеры API&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Компонент: FastAPI APIRouter]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;/auth, /requests, /dispatcher, /contractor, /admin, /reports, /notifications. Проверка данных (Pydantic), проверка JWT и роли через Depends&lt;/div&gt;" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#000000;align=center;arcSize=10;strokeColor=#78A8D8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="40" y="245" width="900" height="95" as="geometry"/></mxCell><mxCell id="v47" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Фоновые задачи&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Компонент: планировщик]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Каждую ночь: фото-сироты старше 24 ч, просроченные refresh-токены&lt;/div&gt;" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#000000;align=center;arcSize=10;strokeColor=#78A8D8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="980" y="245" width="210" height="95" as="geometry"/></mxCell><mxCell id="v48" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Авторизация&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Компонент: сервис]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Вход по email, JWT, refresh с ротацией, argon2, согласия на ПДн&lt;/div&gt;" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#000000;align=center;arcSize=10;strokeColor=#78A8D8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="40" y="400" width="195" height="105" as="geometry"/></mxCell><mxCell id="v49" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Справочники и отчёты&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Компонент: сервис]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Улицы, группы, подрядчики, пользователи; карта, отчёты&lt;/div&gt;" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#000000;align=center;arcSize=10;strokeColor=#78A8D8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="255" y="400" width="195" height="105" as="geometry"/></mxCell><mxCell id="v50" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Заявки&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Компонент: сервис]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Создание, change_status() — машина статусов, история, уведомления&lt;/div&gt;" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#000000;align=center;arcSize=10;strokeColor=#78A8D8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="470" y="400" width="195" height="105" as="geometry"/></mxCell><mxCell id="v51" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Автообработка&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Компонент: сервис]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Привязка к улице и дому, ГОСТ: группа и срок, дубли, вызов ML&lt;/div&gt;" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#000000;align=center;arcSize=10;strokeColor=#78A8D8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="765" y="400" width="195" height="105" as="geometry"/></mxCell><mxCell id="v52" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Фото&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Компонент: сервис]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Приём файла, проверка формата и размера, сжатие (Pillow)&lt;/div&gt;" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#000000;align=center;arcSize=10;strokeColor=#78A8D8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="995" y="400" width="195" height="105" as="geometry"/></mxCell><mxCell id="v53" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Клиент ML&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Компонент: httpx]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Таймаут 8 с, при ошибке — «на проверку»&lt;/div&gt;" style="fontFamily=Arial;rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#000000;align=center;arcSize=10;strokeColor=#78A8D8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="820" y="560" width="155" height="85" as="geometry"/></mxCell><mxCell id="v54" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Доступ к данным&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Компонент: SQLAlchemy 2 + GeoAlchem