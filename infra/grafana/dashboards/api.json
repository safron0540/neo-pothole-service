{
  "title": "Ямочный ремонт: API",
  "uid": "pothole-api",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "ПР-2: доля запросов быстрее 1 с",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.95 }] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(api_request_seconds_bucket{le=\"1.0\"}[5m])) / sum(rate(api_request_seconds_count[5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Запросов в секунду",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "refId": "A", "expr": "sum(rate(api_requests_total[5m]))" }]
    },
    {
      "type": "stat",
      "title": "Ошибки сервера (5xx)",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(api_requests_total{status=~\"5..\"}[5m])) or vector(0)) / sum(rate(api_requests_total[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "95-й перцентиль времени ответа по маршрутам",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, route) (rate(api_request_seconds_bucket[5m])))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Запросы по маршрутам",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, route) (rate(api_requests_total[5m]))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    }
  ]
}
