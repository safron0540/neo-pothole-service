# Шаблон настроек. Для запуска: cp .env.example .env
# Файл .env в Git не попадает. На сервере обязательно поменять пароли и JWT_SECRET.

# dev | test | prod. Без этой строки compose считает стенд боевым (prod): там нужен свой
# JWT_SECRET не короче 32 символов, иначе API не запустится. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=dev

# Порты на машине (слушают только localhost)
BACKEND_PORT=8000
DB_PORT=5432
ML_PORT=8001
# nginx: веб-панель и /api на одном адресе (Caddy проксирует сюда)
NGINX_PORT=8080

# База PostgreSQL + PostGIS; DATABASE_URL для backend собирает docker-compose.yml
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=potholes

# Токены
JWT_SECRET=dev-only-change-me
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Фото и ML-сервис
PHOTOS_DIR=/data/photos
ML_URL=http://ml_service:8001
ML_TIMEOUT_SECONDS=8

# Push через Firebase (REQ-031): ключ сервисного аккаунта положить в secrets/firebase.json
# (папка в Git не идёт) и указать FCM_CREDENTIALS_FILE=/run/secrets/firebase.json.
# Пусто — push выключен, гражданин видит уведомления опросом.
FCM_CREDENTIALS_FILE=

# Заглушка ML: random | big | small | no_pit | unavailable | slow
ML_STUB_MODE=random

# Радиусы автообработки, метры: улица, дом, дубликат
STREET_MATCH_RADIUS_M=30
BUILDING_MATCH_RADIUS_M=30
DUPLICATE_RADIUS_M=15

# Адреса веба через запятую (CORS). На сервере — адрес веб-панели, например https://safronspace.ru
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Мониторинг (docker compose --profile monitoring up -d): Grafana на 127.0.0.1:3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=change-me
